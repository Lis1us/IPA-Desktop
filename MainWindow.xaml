<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IPA Desktop · 0.1.6" Width="1160" Height="800" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#10151F" Foreground="#EDF1F8" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#243247"/><Setter Property="Foreground" Value="#EDF1F8"/>
   <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#35465D"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8CB9FF"/><Setter TargetName="B" Property="Opacity" Value="0.88"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#BCD6FF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8390A3"/><Setter TargetName="B" Property="Background" Value="#1A2331"/><Setter TargetName="B" Property="BorderBrush" Value="#263143"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="#192333"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="BorderBrush" Value="#34445C"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#416EC4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#699FFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#151E2C"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#AABAD0"/><Setter Property="Padding" Value="18,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="B" Background="#10151F" Padding="{TemplateBinding Padding}" Margin="0,0,6,6" CornerRadius="8"><ContentPresenter ContentSource="Header"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#202D40"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#284871"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8CB9FF"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#151E2C"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="RowBackground" Value="#182334"/><Setter Property="AlternatingRowBackground" Value="#1C293B"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="44"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202E42"/><Setter Property="Foreground" Value="#A8BCD8"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2A4B77"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#1C293B"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#2A4B77"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#284871"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinWidth" Value="180"/><Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="Background" Value="#1C293B"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="#1C293B" BorderBrush="#34445C" BorderThickness="1" CornerRadius="8"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#AEC4E2" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8CB9FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,9,32,9" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Background="#1C293B" BorderBrush="#405574" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
    </Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="BrandIcon" Width="46" Height="46" Margin="0,0,12,0"/><TextBlock Text="IPA Desktop" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#23354E" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="0.1.6" Foreground="#AFCDF7" FontSize="12"/></Border></StackPanel><TextBlock Text="Приложения для iPhone — поиск, загрузка и установка" Foreground="#9BACBF" Margin="0,6,0,20"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="EngineVersion" Text="Движок не установлен" Foreground="#78B7FF" HorizontalAlignment="Right"/><TextBlock x:Name="AccountLabel" Text="Аккаунт не проверен" Margin="0,6,0,0" Foreground="#9BACBF"/></StackPanel></Grid>
  <StackPanel Grid.Row="1"><TextBlock x:Name="UpdateNotice" Foreground="#8CBAFF" Margin="0,0,0,8"/><WrapPanel x:Name="AccountActions"><Button x:Name="Login" Content="Войти в Apple Account" Background="#3878E5"/><Button x:Name="AccountInfo" Content="Проверить аккаунт"/><Button x:Name="Logout" Content="Выйти"/><Button x:Name="OpenFolder" Content="Папка IPA"/></WrapPanel></StackPanel>
  <TabControl Grid.Row="2" Margin="0,12,0,16">
   <TabItem Header="Поиск и загрузка"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Query" ToolTip="Название или числовой App Store ID"/><Button x:Name="Search" Content="Найти" Grid.Column="1" Margin="10,0,0,0"/></Grid>
    <DataGrid x:Name="Apps" Grid.Row="1" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Приложение" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="App Store ID" Binding="{Binding ID}" Width="180"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="Versions" Content="Загрузить список версий"/><ComboBox x:Name="VersionList" Margin="0,0,8,8"/><Button x:Name="VersionInfo" Content="Сведения о версии"/><Button x:Name="Download" Content="Скачать выбранное" Background="#3878E5"/></WrapPanel>
    <TextBlock Grid.Row="3" Text="Ctrl / Shift — выбрать несколько приложений. Без выбора версии скачивается последняя.&#10;Загрузка может потребовать получения бесплатной лицензии; ограничения Apple Account сохраняются." Foreground="#9BACBF" TextWrapping="Wrap"/>
   </Grid></TabItem>
   <TabItem Header="Файлы и устройство"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button x:Name="RefreshFiles" Content="Обновить файлы"/><Button x:Name="ImportFile" Content="Добавить IPA…"/><Button x:Name="DeleteFiles" Content="Удалить выбранные" Background="#713B48"/><Button x:Name="Devices" Content="Найти iPhone"/><ComboBox x:Name="DeviceList" Margin="0,0,8,8"/></WrapPanel><DataGrid x:Name="Files" Grid.Row="1" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Apple Account" Binding="{Binding AppleAccount}" Width="280"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="140"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" x:Name="InstallFiles" Content="Установить выбранные IPA" HorizontalAlignment="Left" Background="#3878E5" Margin="0,14,0,8"/><TextBlock Grid.Row="3" Text="Подключите iPhone по USB, разблокируйте его и подтвердите доверие компьютеру.&#10;Для установки нужен драйвер Apple Mobile Device Support. Совместимость IPA проверяет установщик." Foreground="#9BACBF" TextWrapping="Wrap"/></Grid></TabItem>
   <TabItem Header="Обновления"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <Border Background="#1C293B" BorderBrush="#34445C" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24"><StackPanel>
     <TextBlock Text="IPA Desktop" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock x:Name="GuiVersionStatus" Text="Установлена версия 0.1.6" Foreground="#8CBAFF" Margin="0,8,0,14"/>
     <CheckBox x:Name="CheckGuiUpdates" Content="Проверять новые версии программы при запуске" Foreground="#EDF1F8" Margin="0,0,0,16"/>
     <WrapPanel><Button x:Name="CheckGuiUpdate" Content="Проверить версию"/><Button x:Name="InstallGuiUpdate" Content="Установить обновление" IsEnabled="False" Background="#3878E5"/><Button x:Name="OpenGuiReleases" Content="Все версии"/></WrapPanel>
     <TextBlock Text="Установка — после подтверждения. Программа перезапустится, ваши IPA и настройки сохранятся." Foreground="#9BACBF" TextWrapping="Wrap"/>
    </StackPanel></Border><TextBlock Text="Движок IPA Downloader" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Источник: kda2495 / IPA_Downloader · GitHub Releases" Foreground="#78B7FF" Margin="0,12,0,24"/><CheckBox x:Name="AutoUpdate" Foreground="#EDF1F8" Content="Проверять и устанавливать новые релизы при запуске" Margin="0,0,0,20"/><WrapPanel><Button x:Name="CheckUpdate" Content="Проверить обновления" Background="#3878E5"/><Button x:Name="Rollback" Content="Откатить движок"/><Button x:Name="OpenRelease" Content="Открыть релизы на GitHub"/></WrapPanel><TextBlock Text="Обновление выполняется только при отсутствии активной операции.&#10;Архив распаковывается отдельно; переключение — после проверки запуска и наличия команд.&#10;Предыдущая версия сохраняется для отката. Папка IPA не заменяется.&#10;&#10;Проверка команд не гарантирует совместимость всех ответов: при ошибках можно откатиться.&#10;Новые функции исходного скрипта могут потребовать обновления самого интерфейса.&#10;&#10;В версии 0.1 вход и 2FA проходят в штатном консольном окне ipatool.&#10;Существующая сессия ipatool используется совместно. Защищённую отдельной фразой&#10;сессию и переключение нескольких аккаунтов выполняйте через исходный скрипт." Foreground="#9BACBF" TextWrapping="Wrap" LineHeight="24" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Журнал"><TextBox x:Name="Journal" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="18"/></TabItem>
  </TabControl>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Status" Text="Готово" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Foreground="#5094FF" Background="#29364C"/></StackPanel><Button x:Name="Cancel" Grid.Column="1" Content="Отмена" IsEnabled="False" Margin="16,0,0,0"/></Grid>
 </Grid>
</Window>
