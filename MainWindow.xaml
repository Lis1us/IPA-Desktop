<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IPA Desktop · 0.1.4" Width="1160" Height="800" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#10151F" Foreground="#EDF1F8" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#29364C"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#1C2738"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="BorderBrush" Value="#36465F"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#151E2C"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A9B9CE"/><Setter Property="Padding" Value="16,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="B" Background="#1C2738" Padding="{TemplateBinding Padding}" Margin="0,0,6,0" CornerRadius="6,6,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#304D75"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#151E2C"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="RowBackground" Value="#1C2738"/><Setter Property="AlternatingRowBackground" Value="#202D40"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="42"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#29364C"/><Setter Property="Foreground" Value="#AEC0D8"/><Setter Property="Padding" Value="12"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,4"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="MinWidth" Value="180"/><Setter Property="Foreground" Value="#10151F"/></Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IPA Desktop" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Приложения, версии и загрузки — в одном окне" Foreground="#9BACBF" Margin="0,6,0,20"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="EngineVersion" Text="Движок не установлен" Foreground="#78B7FF" HorizontalAlignment="Right"/><TextBlock x:Name="AccountLabel" Text="Аккаунт не проверен" Margin="0,6,0,0" Foreground="#9BACBF"/></StackPanel></Grid>
  <WrapPanel Grid.Row="1" x:Name="AccountActions"><Button x:Name="Login" Content="Войти в Apple Account" Background="#326FDB"/><Button x:Name="AccountInfo" Content="Проверить аккаунт"/><Button x:Name="Logout" Content="Выйти"/><Button x:Name="OpenFolder" Content="Папка IPA"/></WrapPanel>
  <TabControl Grid.Row="2" Margin="0,12,0,16">
   <TabItem Header="Поиск и загрузка"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Query" ToolTip="Название или числовой App Store ID"/><Button x:Name="Search" Content="Найти" Grid.Column="1" Margin="10,0,0,0"/></Grid>
    <DataGrid x:Name="Apps" Grid.Row="1" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Приложение" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="App Store ID" Binding="{Binding ID}" Width="180"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="Versions" Content="Загрузить список версий"/><ComboBox x:Name="VersionList" Margin="0,0,8,8"/><Button x:Name="VersionInfo" Content="Сведения о версии"/><Button x:Name="Download" Content="Скачать выбранное" Background="#326FDB"/></WrapPanel>
    <TextBlock Grid.Row="3" Text="Ctrl / Shift — выбрать несколько приложений. Без выбора версии скачивается последняя.&#10;Загрузка может потребовать получения бесплатной лицензии; ограничения Apple Account сохраняются." Foreground="#9BACBF" TextWrapping="Wrap"/>
   </Grid></TabItem>
   <TabItem Header="Файлы и устройство"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button x:Name="RefreshFiles" Content="Обновить файлы"/><Button x:Name="ImportFile" Content="Добавить IPA…"/><Button x:Name="DeleteFiles" Content="Удалить выбранные" Background="#713B48"/><Button x:Name="Devices" Content="Найти iPhone"/><ComboBox x:Name="DeviceList" Margin="0,0,8,8"/></WrapPanel><DataGrid x:Name="Files" Grid.Row="1" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="140"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" x:Name="InstallFiles" Content="Установить выбранные IPA" HorizontalAlignment="Left" Background="#326FDB" Margin="0,14,0,8"/><TextBlock Grid.Row="3" Text="Подключите iPhone по USB, разблокируйте его и подтвердите доверие компьютеру.&#10;Для установки нужен драйвер Apple Mobile Device Support. Совместимость IPA проверяет установщик." Foreground="#9BACBF" TextWrapping="Wrap"/></Grid></TabItem>
   <TabItem Header="Обновления"><StackPanel Margin="24"><TextBlock Text="Постоянный интерфейс. Обновляемый движок." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Источник: kda2495 / IPA_Downloader · GitHub Releases" Foreground="#78B7FF" Margin="0,12,0,24"/><CheckBox x:Name="AutoUpdate" Foreground="#EDF1F8" Content="Проверять и устанавливать новые релизы при запуске" Margin="0,0,0,20"/><WrapPanel><Button x:Name="CheckUpdate" Content="Проверить обновления" Background="#326FDB"/><Button x:Name="Rollback" Content="Откатить движок"/><Button x:Name="OpenRelease" Content="Открыть релизы на GitHub"/></WrapPanel><TextBlock Text="Обновление выполняется только при отсутствии активной операции.&#10;Архив распаковывается отдельно; переключение — после проверки запуска и наличия команд.&#10;Предыдущая версия сохраняется для отката. Папка IPA не заменяется.&#10;&#10;Проверка команд не гарантирует совместимость всех ответов: при ошибках можно откатиться.&#10;Новые функции исходного скрипта могут потребовать обновления самого интерфейса.&#10;&#10;В версии 0.1 вход и 2FA проходят в штатном консольном окне ipatool.&#10;Существующая сессия ipatool используется совместно. Защищённую отдельной фразой&#10;сессию и переключение нескольких аккаунтов выполняйте через исходный скрипт." Foreground="#9BACBF" TextWrapping="Wrap" LineHeight="24" Margin="0,20,0,0"/></StackPanel></TabItem>
   <TabItem Header="Журнал"><TextBox x:Name="Journal" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="18"/></TabItem>
  </TabControl>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Status" Text="Готово" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Foreground="#5094FF" Background="#29364C"/></StackPanel><Button x:Name="Cancel" Grid.Column="1" Content="Отмена" IsEnabled="False" Margin="16,0,0,0"/></Grid>
 </Grid>
</Window>
